  "glossary": [
    {
      "term": "Agentic Robot",
      "translation": "具身智能体机器人",
      "definition": "A robotic system that connects reasoning models with physical embodiment, tools, memory, and environment interaction for autonomous closed-loop execution and self-evolution."
    },
    {
      "term": "Model",
      "translation": "模型域",
      "definition": "Foundational representations, policies, world models, and reasoning engines driving robotic perception and control."
    },
    {
      "term": "Data",
      "translation": "数据域",
      "definition": "Processes for collection, autonomous annotation, curation, and refinement of multimodal robot experience."
    },
    {
      "term": "Environment",
      "translation": "环境域",
      "definition": "Simulation engines, 3D reconstruction pipelines, and dynamic benchmark environments supporting physical robot testing."
    },
    {
      "term": "Harness",
      "translation": "支架 / 治理框架域",
      "definition": "Orchestration software, memory frameworks, tool-use abstractions, and guardrails coordinating robot skills and models."
    }
  ]
}