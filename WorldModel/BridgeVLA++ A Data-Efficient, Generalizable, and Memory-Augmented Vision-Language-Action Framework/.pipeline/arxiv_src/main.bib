% ---------------------------------------------------------------- IEEEtran.bst
% IEEE style truncates any reference with MORE THAN SIX authors to the first
% author followed by "et al."; references with six or fewer list every author.
% IEEEtran.bst does not do this by default (it prints every name it is given),
% so the rule is enforced here rather than by hand-writing "and others" in the
% author fields. Activated by \bstctlcite{IEEEexample:BSTcontrol} in main.tex.
%   CTLuse_forced_etal       -- enable forced truncation
%   CTLmax_names_forced_etal -- truncate when the author count exceeds this
%   CTLnames_show_etal       -- how many names survive the truncation
% Requires IEEEtran.bst >= 1.10 (this tree has 1.14).
@IEEEtranBSTCTL{IEEEexample:BSTcontrol,
  CTLuse_forced_etal       = "yes",
  CTLmax_names_forced_etal = "6",
  CTLnames_show_etal       = "1"
}

