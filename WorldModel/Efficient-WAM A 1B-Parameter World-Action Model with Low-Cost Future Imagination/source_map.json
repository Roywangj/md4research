  "glossary": [
    {
      "term": "World-Action Model (WAM)",
      "translation": "世界—动作模型",
      "note": "Jointly predicts future visual evolution and robot actions; retain WAM after first use."
    },
    {
      "term": "Efficient-WAM",
      "translation": "Efficient-WAM",
      "note": "Compact 1B-parameter structural baseline; model name remains English."
    },
    {
      "term": "Efficient-WAM-RT",
      "translation": "Efficient-WAM-RT",
      "note": "Fully optimized real-time variant with low-resolution futures and asymmetric denoising."
    },
    {
      "term": "action-centric future imagination",
      "translation": "以动作为中心的未来想象",
      "note": "Future prediction optimized as control guidance rather than photorealistic rendering."
    },
    {
      "term": "Mixture-of-Transformers (MoT)",
      "translation": "Transformer 混合架构",
      "note": "Layer-wise interaction between video and action experts."
    },
    {
      "term": "world-knowledge transfer",
      "translation": "世界知识迁移",
      "note": "Structured layer slicing plus teacher-guided distillation from WAN-2.2-5B."
    },
    {
      "term": "future video latent",
      "translation": "未来视频潜变量",
      "note": "$z_v$; low-resolution token-sparse future representation."
    },
    {
      "term": "asymmetric video-action denoising",
      "translation": "非对称视频—动作去噪",
      "note": "Different denoising budgets $T_v$ and $T_a$."
    },
    {
      "term": "flow matching",
      "translation": "流匹配",
      "note": "Conditional generative objective used for video and action branches."
    },
    {
      "term": "action chunk",
      "translation": "动作块",
      "note": "A horizon-$H$ sequence; here $H=16$."
    },
    {
      "term": "Clean / Random",
      "translation": "干净 / 随机化",
      "note": "RoboTwin 2.0 evaluation settings."
    },
    {
      "term": "latency per chunk",
      "translation": "每动作块延迟",
      "note": "Wall-clock policy-call latency for predicting one $H=16$ chunk."
    }
