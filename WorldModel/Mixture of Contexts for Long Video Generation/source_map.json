  "glossary": [
    {
      "term": "Mixture of Contexts (MoC)",
      "translation": "上下文混合（MoC）",
      "note": "Learnable sparse attention routing module for long-context video memory retrieval."
    },
    {
      "term": "content-aligned chunks",
      "translation": "内容对齐块",
      "note": "Variable-length sequence slices aligned with frame, shot, and caption boundaries."
    },
    {
      "term": "mean-pooled key",
      "translation": "均值池化键",
      "note": "Arithmetic mean of key vectors inside a chunk used as representation descriptor."
    },
    {
      "term": "top-k selection",
      "translation": "top-k 选择",
      "note": "Retrieval of k most relevant chunks per query based on inner products."
    },
    {
      "term": "causal routing",
      "translation": "因果路由",
      "note": "Restricting query tokens to attend only to earlier chunks to eliminate closed-loop cycles."
    },
    {
      "term": "loop closures",
      "translation": "回路闭合 / 自反馈闭环",
      "note": "Pathological feedback cycles between bidirectional chunks causing repeated frames."
    },
    {
      "term": "attention sink",
      "translation": "注意力汇聚",
      "note": "Mandatory cross-modal links to text prompt tokens ensuring low-entropy anchoring and gradient flow."
    },
    {
      "term": "intra-shot local window",
      "translation": "镜头内局部窗口",
      "note": "Forced dense self-attention within each individual shot preserving high-frequency details."
    },
    {
      "term": "context drop-off",
      "translation": "上下文丢弃",
      "note": "Randomly masking selected chunks to promote representation redundancy."
    },
    {
      "term": "context drop-in",
      "translation": "上下文注入",
      "note": "Randomly inserting extraneous chunks to prevent dead routes and balance gradients."
    },
    {
      "term": "per-head distributed routing",
      "translation": "分头分布式路由",
      "note": "Independent chunk selection for each attention head across all layers."
    },
    {
      "term": "outer loop context routing",
      "translation": "外循环上下文路由",
      "note": "Hierarchical coarse-grained shot selection enabling scaling to million-token sequences."
    }
  ],
