  "glossary": [
    {"term": "World Action Model (WAM)", "translation": "世界动作模型", "note": "Jointly models future world state and action."},
    {"term": "Vision-Language-Action model (VLA)", "translation": "视觉—语言—动作模型", "note": "Extends a VLM with motor-action prediction."},
    {"term": "inverse dynamics model (IDM)", "translation": "逆动力学模型", "note": "Maps visual state changes or predicted futures to actions."},
    {"term": "embodiment", "translation": "机器人形态", "note": "Kept in English in mixed technical phrases."},
    {"term": "task progress", "translation": "任务进度", "note": "Partial completion metric, not universally identical to success."},
    {"term": "flow matching", "translation": "流匹配", "note": "Joint video-action denoising objective."},
    {"term": "action chunk", "translation": "动作块", "note": "Contiguous control sequence predicted and asynchronously executed."}
