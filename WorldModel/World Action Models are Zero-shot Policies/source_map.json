  "blocks": [
    {"id": "S001", "type": "body", "section": "Abstract", "pages": "2", "summary": "Problem, DreamZero definition, generalization, 7 Hz, and cross-embodiment headline results."},
    {"id": "S002", "type": "body", "section": "Introduction", "pages": "2-4", "summary": "VLA semantic priors do not supply unseen physical motions; WAM reframes action learning through visual futures and inverse dynamics."},
    {"id": "S003", "type": "body", "section": "Related Work", "pages": "4-6", "summary": "VLA scaling, video planning, joint video-action generation, pretrained video diffusion, and latent world models."},
    {"id": "S004", "type": "equation", "section": "DreamZero / Problem Formulation", "pages": "6-7", "summary": "Joint distribution factorization into future-video prediction and inverse dynamics."},
    {"id": "S005", "type": "body", "section": "DreamZero / Architecture", "pages": "6-8", "summary": "Causal DiT, robot-specific encoders/decoders, multi-view concatenation, and chunk-wise autoregression."},
    {"id": "S006", "type": "equation", "section": "DreamZero / Training", "pages": "7-8", "summary": "Joint flow-matching interpolation, velocity target, teacher forcing, and causal attention."},
    {"id": "S007", "type": "body", "section": "DreamZero / Inference", "pages": "8", "summary": "KV caching, asynchronous execution, and replacement of generated frames with real observations."},
    {"id": "S008", "type": "body", "section": "Real-time Execution", "pages": "8-10", "summary": "5.7 s baseline bottleneck, 48-step chunks at 30 Hz, CFG parallelism, caching, compile, kernels, and quantization."},
    {"id": "S009", "type": "body", "section": "DreamZero-Flash", "pages": "9-10", "summary": "Decoupled video/action noise schedules for one-step action recovery from noisy visual context."},
    {"id": "S010", "type": "body", "section": "Experimental Setup / Pretraining", "pages": "10-12", "summary": "AgiBot and DROID data, baselines, 100K-step training, freezing policy, and OOD evaluation philosophy."},
    {"id": "S011", "type": "body", "section": "Experimental Setup / Evaluation", "pages": "12-13", "summary": "Seen/unseen task definitions, AgiBot and DROID rollout counts, and post-training tasks."},
    {"id": "S012", "type": "body", "section": "Results / Seen Tasks", "pages": "13", "summary": "62.2% AgiBot average progress and corresponding DROID trend."},
    {"id": "S013", "type": "body", "section": "Results / Unseen Tasks", "pages": "14", "summary": "39.5% AgiBot unseen progress; 49% progress and 22.5% success on DROID-Franka."},
