  "equations": [
    {"id": "E001", "page": 13, "section": "B.1", "latex": "IoU_t = |M^{GT}_t \\cap M^{pred}_t| / |M^{GT}_t \\cup M^{pred}_t|"},
    {"id": "E002", "page": 14, "section": "B.2", "latex": "s^{(t)}_n = max(0, 1 - a^{(t)}_n / a^{(0)}_n)"},
    {"id": "E003", "page": 14, "section": "B.2", "latex": "OCS = max_{n,t>0} s^{(t)}_n"},
    {"id": "E004", "page": 14, "section": "B.3", "latex": "e_t = max(J^{pred}_t - J^{GT}_t, 0)"},
    {"id": "E005", "page": 14, "section": "B.3", "latex": "anomaly = 1[max_t e_t > tau]"},
    {"id": "E006", "page": 15, "section": "D", "latex": "tau^{m*} = argmin_tau (1/N) sum_i [c^m_{i,VLM} if p^m_i < tau else c^m_{i,VDM}]"}
  ],
  "glossary": {
    "MPM": "Material Point Method / 物质点法",
    "VLM": "Vision-Language Model (code generation) / 视觉-语言模型（代码生成）, base = Qwen2.5-VL-7B-Instruct",
    "VDM": "Video Diffusion Model / 视频扩散模型, baseline = 14B LongCat",
    "W-MAE": "Windowed Motion Activity Error / 窗口化运动活跃度误差 (lower better)",
    "CTV": "Color Total Variation / 颜色全变差 (lower better)",
    "OCS": "Object Collapse Score / 物体坍缩分数 (lower better)",
    "mIoU": "Mask IoU / 掩膜交并比 (higher better)",
    "RTSJ": "Temporal Anomaly Rate / 时间异常率 (lower better)",
    "SEMD": "sliced Earth Mover's Distance / 切片地动距离",
    "Scene Template": "core 10k unique physical setups (Parent + Child) / 场景模板",
    "side information f(rho)": "physically-relevant privileged info extracted from program / 旁路（特权）信息"
  },
